# OpenAI API 키 (필수) — https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-your-key-here

# 사용할 모델 — gpt-4o-mini 가 가성비 최고 (변경 비권장)
OPENAI_MODEL=gpt-4o-mini

# MongoDB 연결 URI (선택, 기본값: 로컬)
MONGO_URI=mongodb://localhost:27017

# 과금 절약 옵션 (숫자 올리면 품질↑ 비용↑)
MAX_TOKENS_CHAT=200
MAX_TOKENS_CODE=400
RECENT_CONTEXT=6
SIMILAR_CONTEXT=2
MAX_MSG_CHARS=400
